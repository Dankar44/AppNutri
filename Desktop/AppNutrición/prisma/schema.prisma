generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Dietista {
  id              String    @id @default(cuid())
  authId          String    @unique
  email           String    @unique
  nombre          String
  apellidos       String
  telefono        String?
  especialidad    String?
  numColegiado    String?
  clinica         String?
  logoUrl         String?
  verificado      Boolean   @default(false)
  creadoPor       String?
  fuenteContacto  String?
  demoEliminado   Boolean   @default(false)
  notifPreferencias Json?
  lastAccessAt    DateTime?
  stripeAccountId String?
  stripeOnboarded Boolean   @default(false)
  earlyAdopter    Boolean   @default(false)
  horarioLaboral  Json?
  duracionCitaDefault Int?
  pdfLogoUrl      String?
  marcaPdf        String?
  temaPdf         String?
  colorPrimarioPdf String?
  camposAnamnesis Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pacientes       Paciente[]
  planificaciones Planificacion[]
  alimentos       Alimento[]
  recetas         Receta[]
  planes          PlanAlimenticio[]
  plantillas      Plantilla[]
  plantillasAnamnesis PlantillaAnamnesis[]
  consultas       Consulta[]
  citas           Cita[]
  enlacesCompartidos EnlaceCompartido[]
  generacionesIA  GeneracionIA[]
  notificaciones  Notificacion[]
  suscripcion     Suscripcion?
  pagos           Pago[]
  recetasFavoritas RecetaFavorito[]
  conversaciones  Conversacion[]
  mensajes        Mensaje[]
  mensajesSoporte MensajeSoporte[]
  googleIntegracion GoogleIntegracion?
  noLeidosSoporte Int       @default(0)
  empresaId       String?
  empresa         Empresa?  @relation("EmpresaMiembros", fields: [empresaId], references: [id], onDelete: SetNull)
  empresaLiderada Empresa?  @relation("EmpresaLider")
  solicitudesEmpresa SolicitudEmpresa[]
  movimientosStock   MovimientoStock[]

  /// #39 — Módulo docente. NULL = nutricionista normal (todas las cuentas de hoy).
  /// El rol SOLO se concede desde /admin: no hay manera de pedirlo al registrarse.
  rolDocente         RolDocente?
  licenciaDocenteId  String?
  licenciaDocente    LicenciaDocente? @relation(fields: [licenciaDocenteId], references: [id], onDelete: SetNull)
  /// La cuenta nació de una clase. No se convierte en cuenta normal: al quitarle el acceso al
  /// acabar el curso, registrarse otra vez con ese correo no le devolvería el uso gratis.
  cuentaDeClase      Boolean   @default(false)
  /// Cuándo dejó de ser alumno (se quedó sin clases vivas y pasó a cuenta normal).
  exAlumnoDesde       DateTime?
  /// Si ya se le enseñó el aviso de que su año escolar terminó y la cuenta se le queda.
  avisoFinCursoVisto  Boolean   @default(false)
  clasesImpartidas   Clase[]
  clasesQueLleva     ProfesorClase[]
  matriculas         AlumnoClase[]
  casosClinicos      CasoClinico[]   @relation("CasosDelProfesor")
  entregasDeCasos    EntregaCaso[]   @relation("EntregasDelAlumno")

  @@index([licenciaDocenteId])
  @@map("dietistas")
}

enum PlanSuscripcion {
  BASICO
  PROFESIONAL
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
  EXPIRADA
  PRUEBA
}

model Suscripcion {
  id              String             @id @default(cuid())
  dietistaId      String             @unique
  dietista        Dietista           @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  plan            PlanSuscripcion    @default(BASICO)
  estado          EstadoSuscripcion  @default(PRUEBA)
  fechaInicio     DateTime           @default(now())
  fechaFin        DateTime?
  stripeCustomerId    String?
  stripeSubscriptionId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("suscripciones")
}

model Pago {
  id                String    @id @default(cuid())
  dietistaId        String
  dietista          Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  pacienteId        String?
  paciente          Paciente? @relation(fields: [pacienteId], references: [id], onDelete: SetNull)
  concepto          String
  importe           Float
  estado            String    @default("PENDIENTE")
  metodoPago        String?
  fechaPago         DateTime?
  notas             String?
  stripePaymentUrl  String?
  stripeSessionId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("pagos")
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
}

enum ObjetivoPaciente {
  PERDER_PESO
  GANAR_MASA
  MANTENIMIENTO
  PATOLOGIA
  DEPORTIVO
  OTRO
}

enum CategoriaAlimento {
  FRUTAS
  VERDURAS
  CEREALES
  LEGUMBRES
  CARNES
  PESCADOS
  LACTEOS
  HUEVOS
  FRUTOS_SECOS
  ACEITES
  BEBIDAS
  CONDIMENTOS
  DULCES
  OTROS
}

enum UnidadMedida {
  GRAMOS
  MILILITROS
  UNIDAD
  CUCHARADA
  CUCHARADITA
  TAZA
  REBANADA
  PIEZA
  LATA
  LONCHA
}

enum OrigenAlimento {
  API
  PERSONALIZADO
}

enum TipoComida {
  DESAYUNO
  MEDIA_MANANA
  ALMUERZO
  MERIENDA
  CENA
  RECENA
  /// Comida personalizada añadida a un día concreto (#104 Fase 2); se identifica por su nombre.
  OTRA
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model Paciente {
  id                  String            @id @default(cuid())
  dietistaId          String
  dietista            Dietista          @relation(fields: [dietistaId], references: [id], onDelete: Cascade)

  nombre              String
  apellidos           String
  email               String?
  telefono            String?
  fotoUrl             String?
  fechaNacimiento     DateTime?
  sexo                Sexo?

  peso                Float?
  altura              Float?

  alergias            String[]
  intolerancias       String[]
  patologias          String[]
  medicamentos        String[]
  suplementos         String[]

  objetivo            ObjetivoPaciente  @default(MANTENIMIENTO)
  objetivoDetalle     String?

  nivelActividad      String?
  frecuenciaEjercicio String?
  tipoEjercicio       String?
  horarioTrabajo      String?
  horarioEjercicio    String?
  horasDescanso       String?
  ocupacion           String?

  preferencias        String[]
  notas               String?

  /// Avisos de cita al paciente (configurables por paciente).
  avisarPorEmail      Boolean  @default(true)
  avisarPorWhatsapp   Boolean  @default(false)

  /// Formulario extendido tipo ficha clínica (pestaña Información)
  fichaInformacion    Json?

  /// Preconsulta (#6): el paciente rellena su propia anamnesis con un link antes de la consulta.
  /// Estado derivado de los timestamps: sin enviar / enviada / completada.
  preconsultaToken        String?   @unique
  preconsultaEnviadaAt    DateTime?
  preconsultaCompletadaAt DateTime?

  /// Plantilla de anamnesis aplicada (#18). Null = anamnesis genérica (4 secciones base + campos globales).
  plantillaAnamnesisId String?
  plantillaAnamnesis   PlantillaAnamnesis? @relation(fields: [plantillaAnamnesisId], references: [id], onDelete: SetNull)

  /// Anamnesis PROPIA del paciente (#18 Fase 2B): estructura editada solo para él. Tiene prioridad sobre
  /// la plantilla. Null = usa su plantilla (tipo) o, si no tiene, la genérica.
  estructuraAnamnesis  Json?

  /// Horario de paciente (guardado como JSONB)
  horario             Json?
  /// Recomendaciones clínicas (guardadas como texto)
  recomendaciones     String?

  fichaSidebar        Json?
  esDemo              Boolean           @default(false)
  /// #40 — Nació de un caso de clase: se etiqueta en su lista y no cuenta como paciente real.
  esDeClase           Boolean           @default(false)
  activo              Boolean           @default(true)
  /// Si true, el paciente no ve calorías ni macros (portal, PDF, seguimiento). El dietista siempre los ve.
  ocultarCalorias     Boolean           @default(false)
  lastAccessAt        DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  planes              PlanAlimenticio[]
  medidas             MedidaAntropometrica[]
  consultas           Consulta[]
  citas               Cita[]
  acceso              AccesoPaciente?
  entradasDiario      EntradaDiario[]
  generacionesIA      GeneracionIA[]
  seguimiento         SeguimientoDiario[]
  notificaciones      Notificacion[]
  conversaciones      Conversacion[]
  mensajes            Mensaje[]
  pagos               Pago[]
  planificaciones     Planificacion[]
  googleIntegracion   GoogleIntegracionPaciente?
  entregaCaso         EntregaCaso?

  @@map("pacientes")
}

model PlantillaAnamnesis {
  id          String     @id @default(cuid())
  dietistaId  String
  dietista    Dietista   @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  nombre      String
  /// Estructura completa de la anamnesis: secciones ordenadas con preguntas fijas (ref al catálogo) o
  /// propias (custom). Forma del JSON en src/lib/anamnesis-plantillas.ts (EstructuraPlantilla).
  estructura  Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  pacientes   Paciente[]

  @@index([dietistaId])
  @@map("plantillas_anamnesis")
}

model Planificacion {
  id                String    @id @default(dbgenerated("gen_random_uuid()::text"))
  pacienteId        String
  paciente          Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  dietistaId        String
  dietista          Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  nombre            String
  estado            String    @default("activa")
  esDefecto         Boolean   @default(false)
  datos             Json      @default("{}")
  fechaInicio       DateTime  @default(now())
  fechaUltimoCambio DateTime  @default(now())
  fechaFinPrevista  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  dias              DiaDelPlan[]

  @@map("planificaciones")
}

model Alimento {
  id              String            @id @default(cuid())
  nombre          String
  nombreNormalizado String?         @map("nombreNormalizado")
  categoria       CategoriaAlimento
  calorias        Float
  proteinas       Float
  carbohidratos   Float
  grasas          Float
  fibra           Float             @default(0)
  // Micronutrientes (por 100g)
  vitaminaA       Float?            // ug
  vitaminaB6      Float?            // mg
  vitaminaB12     Float?            // ug
  vitaminaC       Float?            // mg
  vitaminaD       Float?            // ug
  vitaminaE       Float?            // mg
  vitaminaK       Float?            // ug
  tiamina         Float?            // mg (B1)
  riboflavina     Float?            // mg (B2)
  niacina         Float?            // mg (B3)
  folato          Float?            // ug (B9)
  acidoPantotenico Float?           // mg (B5)
  colina          Float?            // mg
  calcio          Float?            // mg
  hierro          Float?            // mg
  magnesio        Float?            // mg
  fosforo         Float?            // mg
  potasio         Float?            // mg
  sodio           Float?            // mg
  cinc            Float?            // mg
  cobre           Float?            // mg
  manganeso       Float?            // mg
  selenio         Float?            // ug
  fluor           Float?            // ug
  porcion         Float             @default(100)
  unidad          UnidadMedida      @default(GRAMOS)
  origen          OrigenAlimento    @default(PERSONALIZADO)
  codigoBarras    String?
  enlaceProducto  String?
  imagenUrl       String?
  dietistaId      String?
  dietista        Dietista?         @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  stock           Int?
  precioUnitario  Float?
  stockMinimo     Int?
  compartido      Boolean           @default(false)

  recetaIngredientes  RecetaIngrediente[]
  alimentosEnComida   AlimentoEnComida[]
  alternativas        AlternativaAlimento[]
  entradasDiario      EntradaDiario[]
  movimientosStock    MovimientoStock[]

  @@index([dietistaId, compartido])
  @@map("alimentos")
}

model Receta {
  id              String    @id @default(cuid())
  nombre          String
  nombreNormalizado String? @map("nombreNormalizado")
  descripcion     String?
  instrucciones   String?
  porciones       Float     @default(1)
  tiempoPreparacion Int?
  calorias        Float     @default(0)
  proteinas       Float     @default(0)
  carbohidratos   Float     @default(0)
  grasas          Float     @default(0)
  fibra           Float     @default(0)
  vitaminaA       Float?
  vitaminaB6      Float?
  vitaminaB12     Float?
  vitaminaC       Float?
  vitaminaD       Float?
  vitaminaE       Float?
  vitaminaK       Float?
  tiamina         Float?
  riboflavina     Float?
  niacina         Float?
  folato          Float?
  acidoPantotenico Float?
  colina          Float?
  calcio          Float?
  hierro          Float?
  magnesio        Float?
  fosforo         Float?
  potasio         Float?
  sodio           Float?
  cinc            Float?
  cobre           Float?
  manganeso       Float?
  selenio         Float?
  fluor           Float?
  dietistaId      String?
  dietista        Dietista? @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Igual que en Alimento: quien la tiene decide si la ven los demás (su centro y, si es
  /// profesor, sus alumnos). Por defecto no se comparte nada.
  compartido      Boolean   @default(false)

  ingredientes    RecetaIngrediente[]
  alimentosEnComida AlimentoEnComida[]
  alternativas      AlternativaAlimento[]
  entradasDiario    EntradaDiario[]
  favoritos         RecetaFavorito[]

  @@index([dietistaId, compartido])
  @@map("recetas")
}

model RecetaFavorito {
  id          String    @id @default(cuid())
  dietistaId  String
  dietista    Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  recetaId    String
  receta      Receta    @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([dietistaId, recetaId])
  @@map("receta_favoritos")
}

model RecetaIngrediente {
  id          String       @id @default(cuid())
  recetaId    String
  receta      Receta       @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  alimentoId  String
  alimento    Alimento     @relation(fields: [alimentoId], references: [id], onDelete: Cascade)
  cantidad    Float
  unidad      UnidadMedida @default(GRAMOS)

  @@map("receta_ingredientes")
}

model PlanAlimenticio {
  id              String    @id @default(cuid())
  pacienteId      String
  paciente        Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  dietistaId      String
  dietista        Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  nombre          String
  caloriasObjetivo  Float?
  proteinasObjetivo Float?
  carbohidratosObjetivo Float?
  grasasObjetivo    Float?
  /// #78 (bloque 2) — planificaciones que usa este plan (subconjunto de las del paciente).
  planificacionIds String[] @default([])
  /// #78 (bloque 2) — objetivos por planificación propios de ESTE plan (override editable al crear,
  /// sin tocar la planificación). Forma: { "<planificacionId>": { kcal, proteinas, carbohidratos, grasas } }
  objetivosPorPlani Json?
  /// #78-C — Copia del reparto de kcal/macros POR COMIDA, hecha al crear la dieta (igual que las
  /// kcal y macros objetivo): cambiar el reparto en la planificación NO altera las dietas ya
  /// creadas, y lo que el nutri ajuste en la dieta no vuelve a la planificación.
  /// NULL en las dietas anteriores a la feature → esas caen al de la planificación.
  /// Forma: { v: 2, global?: Reparto, porPlani?: { "<planificacionId>": Reparto } }, donde
  ///   Reparto = { activo: boolean, comidas: [{ tipo, incluida, kcalPct, pctPorDia?, nombre?, hora?,
  ///               dias?, grasaPct?, carbPct?, protPct? }] }
  /// `global` es el de los días SIN planificación asignada, que es el caso normal: con una sola
  /// planificación, crearPlan no le pone planificacionId a ningún día. Las dietas guardadas antes
  /// llevan un Reparto suelto (sin `v`) y se siguen leyendo tal cual (ver repartoParaPlani).
  repartoPorComida Json?
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dias            DiaDelPlan[]
  enlaces         EnlaceCompartido[]

  @@map("planes_alimenticios")
}

model DiaDelPlan {
  id      String      @id @default(cuid())
  planId  String
  plan    PlanAlimenticio @relation(fields: [planId], references: [id], onDelete: Cascade)
  dia     DiaSemana
  planificacionId String?
  planificacion   Planificacion? @relation(fields: [planificacionId], references: [id], onDelete: SetNull)
  grupoId String?

  comidas ComidaDelDia[]

  @@unique([planId, dia])
  @@index([grupoId])
  @@map("dias_del_plan")
}

model ComidaDelDia {
  id          String      @id @default(cuid())
  diaId       String
  diaDelPlan  DiaDelPlan @relation(fields: [diaId], references: [id], onDelete: Cascade)
  tipo        TipoComida
  orden       Int         @default(0)
  descripcion String?
  /// Alias visible del nutri (#104): si está, sustituye la etiqueta del tipo (p. ej. "Preentreno").
  nombre      String?
  /// Hora de la comida en formato "HH:MM" (#104), opcional.
  hora        String?

  alimentos AlimentoEnComida[]

  @@map("comidas_del_dia")
}

model AlimentoEnComida {
  id          String       @id @default(cuid())
  comidaId    String
  comida      ComidaDelDia @relation(fields: [comidaId], references: [id], onDelete: Cascade)
  alimentoId  String?
  alimento    Alimento?    @relation(fields: [alimentoId], references: [id], onDelete: SetNull)
  recetaId    String?
  receta      Receta?      @relation(fields: [recetaId], references: [id], onDelete: SetNull)
  cantidad    Float
  unidad      UnidadMedida @default(GRAMOS)
  orden       Int          @default(0)
  /// Alias visual editado por el nutri (solo presentación; no toca macros ni el Alimento).
  nombrePersonalizado String?

  // #5 — Alternativas intercambiables ("o"): otras opciones equivalentes de este mismo ítem.
  alternativas AlternativaAlimento[]

  @@map("alimentos_en_comida")
}

// #5 — Alternativa equivalente de un AlimentoEnComida: "avena 50 g  o  cereales 70 g".
// Puede ser un alimento o una receta. Es excluyente con el principal → NO suma a los macros.
model AlternativaAlimento {
  id                 String           @id @default(cuid())
  alimentoEnComidaId String
  alimentoEnComida   AlimentoEnComida @relation(fields: [alimentoEnComidaId], references: [id], onDelete: Cascade)
  alimentoId         String?
  alimento           Alimento?        @relation(fields: [alimentoId], references: [id], onDelete: SetNull)
  recetaId           String?
  receta             Receta?          @relation(fields: [recetaId], references: [id], onDelete: SetNull)
  cantidad           Float
  unidad             UnidadMedida     @default(GRAMOS)
  orden              Int              @default(0)
  /// Alias visual editado por el nutri (solo presentación; no toca macros ni el Alimento).
  nombrePersonalizado String?

  @@index([alimentoEnComidaId])
  @@map("alternativas_alimento")
}

model Plantilla {
  id          String    @id @default(cuid())
  dietistaId  String
  dietista    Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  nombre      String
  datos       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("plantillas")
}

model MedidaAntropometrica {
  id                  String    @id @default(cuid())
  pacienteId          String
  paciente            Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  fecha               DateTime  @default(now())
  peso                Float?
  altura              Float?
  imc                 Float?
  grasaCorporal       Float?
  masaMuscular        Float?
  perimetroCintura    Float?
  perimetroCadera     Float?
  perimetroBrazo      Float?
  grasaSubcutanea     Float?
  musculoEsqueletico  Float?
  agua                Float?
  masaOsea            Float?
  perimetroAbdomen    Float?
  grasaVisceral       Float?
  pliegueAbdominal    Float?
  pliegueAxilar       Float?
  plieguePectoral     Float?
  pliegueSubescapular Float?
  pliegueSuprailiaco  Float?
  pliegueTricipital   Float?
  pliegueMuslo        Float?
  colesterolHDL       Float?
  colesterolLDL       Float?
  colesterolTotal     Float?
  presionDiastolica   Float?
  presionSistolica    Float?
  trigliceridos       Float?
  notas               String?
  createdAt           DateTime  @default(now())

  consulta            Consulta?

  @@map("medidas_antropometricas")
}

model Consulta {
  id              String    @id @default(cuid())
  pacienteId      String
  paciente        Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  dietistaId      String
  dietista        Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  fecha           DateTime  @default(now())
  motivo          String?
  notas           String?
  medidaId        String?   @unique
  medida          MedidaAntropometrica? @relation(fields: [medidaId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("consultas")
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  CONTRAPROPUESTA
}

enum OrigenCita {
  DIETISTA
  PACIENTE
}

model Cita {
  id              String      @id @default(cuid())
  pacienteId      String
  paciente        Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  dietistaId      String
  dietista        Dietista    @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  fechaHora       DateTime
  duracion        Int         @default(30)
  motivo          String?
  estado          EstadoCita  @default(PENDIENTE)
  notas           String?
  origen          OrigenCita  @default(DIETISTA)
  propuestoPor    OrigenCita  @default(DIETISTA)
  citaOriginalId  String?
  isOnline                Boolean     @default(false)
  googleEventId           String?
  googleEventIdPaciente   String?
  googleMeetLink          String?
  /// Enlace de videollamada introducido a mano por el nutri (Zoom, Meet, Teams...).
  /// Tiene prioridad sobre googleMeetLink en los avisos al paciente.
  enlaceVideollamada      String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  notificaciones  Notificacion[]

  @@map("citas")
}

model GoogleIntegracion {
  id           String   @id @default(cuid())
  dietistaId   String   @unique
  dietista     Dietista @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  calendarId   String   @default("primary")
  sincronizar  Boolean  @default(true)
  crearMeet    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt


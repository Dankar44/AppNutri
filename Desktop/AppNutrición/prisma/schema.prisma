// ─────────────────────────────────────────────────────────────────────────────
// #39 (issue #31) — Módulo docente: cuenta de profesor para universidades
// ─────────────────────────────────────────────────────────────────────────────

enum RolDocente {
  PROFESOR
  ALUMNO
}

/// Lo que se le vende a una universidad: "3 profesores y 300 alumnos", de septiembre a agosto.
/// Las licencias de alumno son una BOLSA COMÚN que se reparten los profesores de esta licencia
/// (no hay cupo fijo por profesor) y cada alumno distinto con acceso consume una — aunque esté
/// en las clases de dos profesores distintos.
///
/// Hoy no hay cobros: la licencia se crea a mano desde /admin. El modelo ya soporta el cobro
/// futuro (qué se contrató, para cuándo y si sigue activa) para no rehacerlo luego.
model LicenciaDocente {
  id            String    @id @default(dbgenerated("gen_random_uuid()::text"))
  institucion   String
  /// Con quién se habla en esa universidad (opcional): nombre, cargo, correo… texto libre.
  personaContacto String?
  /// Dominio de correo de la institución (p. ej. "ua.es"), opcional. Si está, el link de
  /// invitación de clase solo admite alumnos con ese correo; si es NULL, no restringe nada.
  dominioEmail  String?
  maxProfesores Int       @default(1)
  maxAlumnos    Int       @default(0)
  /// Curso académico al que corresponde la bolsa, en texto libre ("2026/27").
  curso         String?
  fechaInicio   DateTime  @default(now())
  /// Fin del curso contratado. Pasada esta fecha el profesor conserva su cuenta y sus casos,
  /// pero no puede dar de alta más alumnos hasta que se renueve.
  fechaFin      DateTime?
  activa        Boolean   @default(true)
  notas         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  miembros      Dietista[]
  invitaciones  InvitacionDocente[]
  casos         CasoClinico[]
  clases        Clase[]

  @@map("licencias_docentes")
}

/// Invitación para entrar en el módulo docente. Nadie pone la contraseña de otro: se manda un
/// correo con un enlace y la persona completa su registro. Guarda el rol porque el mismo
/// mecanismo sirve para los profesores (fase 1) y para los alumnos (fase 2).
model InvitacionDocente {
  id                String    @id @default(dbgenerated("gen_random_uuid()::text"))
  token             String    @unique
  email             String
  rol               RolDocente @default(PROFESOR)
  licenciaDocenteId String?
  licenciaDocente   LicenciaDocente? @relation(fields: [licenciaDocenteId], references: [id], onDelete: Cascade)
  /// A qué clase entra el alumno invitado (los profesores no llevan clase).
  claseId           String?
  clase             Clase?    @relation(fields: [claseId], references: [id], onDelete: Cascade)
  /// Quién invitó: el correo del administrador, o el id del profesor cuando invite a sus alumnos.
  invitadoPor       String?
  expiraAt          DateTime
  /// Cuántas veces se ha mandado el correo y cuándo fue la última: si a alguien se le ha enviado
  /// cuatro veces y sigue sin entrar, el problema no es que se le haya olvidado.
  envios            Int       @default(1)
  ultimoEnvioAt     DateTime?
  aceptadaAt        DateTime?
  aceptadaPorId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([email])
  @@index([licenciaDocenteId])
  @@map("invitaciones_docentes")
}

/// El grupo de un profesor: "Dietoterapia 3º A", curso 2026/27. Los alumnos entran por invitación
/// o por el enlace de la clase, que se puede cerrar cuando ya se han apuntado todos.
model Clase {
  id                String    @id @default(dbgenerated("gen_random_uuid()::text"))
  /// Quien la creó. Es a quien el alumno ve como "su profesor"; los demás que la llevan están en
  /// `profesores`, donde el creador también aparece para que el permiso se compruebe en un sitio.
  profesorId        String
  profesor          Dietista  @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  licenciaDocenteId String?
  licenciaDocente   LicenciaDocente? @relation(fields: [licenciaDocenteId], references: [id], onDelete: SetNull)
  nombre            String
  curso             String?
  tokenInvitacion   String?   @unique
  invitacionAbierta Boolean   @default(true)
  /// Fin del curso de esta clase: pasada la fecha, sus alumnos pierden el acceso. El profesor no.
  fechaFinCurso     DateTime?
  /// Archivar no borra nada: es lo que pasa cuando a un profesor se le retira el rol.
  archivada         Boolean   @default(false)
  archivadaAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  alumnos           AlumnoClase[]
  invitaciones      InvitacionDocente[]
  profesores        ProfesorClase[]
  casosAsignados    AsignacionCaso[]

  @@index([profesorId])
  @@index([licenciaDocenteId])
  @@map("clases")
}

/// Matrícula: un alumno dentro de una clase. Es lo que se activa y se retira cada curso — el
/// trabajo del alumno (sus dietas, sus pacientes de prácticas) no se toca nunca.
///
/// Un alumno en las clases de dos profesores tiene DOS matrículas pero consume UNA licencia: la
/// bolsa se cuenta por alumnos distintos de la licencia, no por matrículas.
/// #39 — Quién lleva una clase. En una facultad la misma asignatura la dan varios profesores, y
/// todos tienen que ver los mismos alumnos y el mismo trabajo. El creador también está aquí.
model ProfesorClase {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  claseId    String
  clase      Clase    @relation(fields: [claseId], references: [id], onDelete: Cascade)
  profesorId String
  profesor   Dietista @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([claseId, profesorId])
  @@index([profesorId])
  @@map("profesores_clase")
}

/// #40 (issue #32) — El caso que escribe el profesor: un paciente ficticio con su historia y lo
/// que se le pide al alumno. Es una plantilla: se asigna a varias clases sin tocarse.
model CasoClinico {
  id                String   @id @default(dbgenerated("gen_random_uuid()::text"))
  profesorId        String
  profesor          Dietista @relation("CasosDelProfesor", fields: [profesorId], references: [id], onDelete: Cascade)
  licenciaDocenteId String?
  licenciaDocente   LicenciaDocente? @relation(fields: [licenciaDocenteId], references: [id], onDelete: SetNull)

  nombre            String
  /// Lo que tiene que entregar el alumno, con sus palabras.
  consigna          String?

  // El paciente ficticio. Mismos campos que un paciente de verdad, porque de aquí sale uno.
  pacienteNombre    String
  pacienteApellidos String   @default("")
  sexo              Sexo?
  fechaNacimiento   DateTime?
  peso              Float?
  altura            Float?
  objetivo          ObjetivoPaciente @default(MANTENIMIENTO)
  objetivoDetalle   String?
  nivelActividad    String?
  patologias        String[]
  alergias          String[]
  intolerancias     String[]
  medicamentos      String[]
  suplementos       String[]
  preferencias      String[]
  notas             String?
  fichaInformacion  Json?

  /// Archivar no borra: las entregas de cursos pasados siguen ahí.
  archivado         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  asignaciones      AsignacionCaso[]

  @@index([profesorId, archivado])
  @@map("casos_clinicos")
}

/// #40 — Un caso puesto a una clase, con su fecha límite.
model AsignacionCaso {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  casoId      String
  caso        CasoClinico @relation(fields: [casoId], references: [id], onDelete: Cascade)
  claseId     String
  clase       Clase     @relation(fields: [claseId], references: [id], onDelete: Cascade)
  fechaLimite DateTime?
  asignadoPor String?
  /// Retirar la asignación no borra lo entregado: deja de verse como pendiente y ya.
  retiradaAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  entregas    EntregaCaso[]

  @@unique([casoId, claseId])
  @@index([claseId])
  @@map("asignaciones_caso")
}

enum EstadoEntrega {
  SIN_EMPEZAR
  EN_MARCHA
  ENTREGADA
  CORREGIDA
}

/// #40 — Lo de cada alumno con un caso: su paciente, su estado y su nota.
model EntregaCaso {
  id                String   @id @default(dbgenerated("gen_random_uuid()::text"))
  asignacionId      String
  asignacion        AsignacionCaso @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  alumnoId          String
  alumno            Dietista @relation("EntregasDelAlumno", fields: [alumnoId], references: [id], onDelete: Cascade)
  /// El paciente se crea la primera vez que lo abre, no al asignarlo: una clase de 300 alumnos
  /// generaría 300 pacientes que quizá nadie llegue a abrir.
  pacienteId        String?  @unique
  paciente          Paciente? @relation(fields: [pacienteId], references: [id], onDelete: SetNull)

  estado            EstadoEntrega @default(SIN_EMPEZAR)
  abiertaAt         DateTime?
  entregadaAt       DateTime?

  nota              Float?
  comentario        String?
  /// La nota no se le enseña hasta que el profesor quiere (acordado el 27 ago 2026).
  visibleParaAlumno Boolean  @default(false)
  corregidaAt       DateTime?
  corregidaPor      String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([asignacionId, alumnoId])
  @@index([alumnoId, estado])
  @@map("entregas_caso")
}

model AlumnoClase {
  id        String    @id @default(dbgenerated("gen_random_uuid()::text"))
  claseId   String
  clase     Clase     @relation(fields: [claseId], references: [id], onDelete: Cascade)
  alumnoId  String
  alumno    Dietista  @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  activa    Boolean   @default(true)
  altaAt    DateTime  @default(now())
  bajaAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([claseId, alumnoId])
  @@index([alumnoId])
  @@map("alumnos_clase")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Dietista {
  id              String    @id @default(cuid())
  authId          String    @unique
  email           String    @unique
  nombre          String
  apellidos       String
  telefono        String?
  especialidad    String?
  numColegiado    String?
  clinica         String?
  logoUrl         String?
  verificado      Boolean   @default(false)
  demoEliminado   Boolean   @default(false)
  notifPreferencias Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pacientes       Paciente[]
  alimentos       Alimento[]
  recetas         Receta[]
  planes          PlanAlimenticio[]
  plantillas      Plantilla[]
  consultas       Consulta[]
  citas           Cita[]
  enlacesCompartidos EnlaceCompartido[]
  generacionesIA  GeneracionIA[]
  notificaciones  Notificacion[]
  suscripcion     Suscripcion?
  recetasFavoritas RecetaFavorito[]
  conversaciones  Conversacion[]
  mensajes        Mensaje[]
  googleIntegracion GoogleIntegracion?

  @@map("dietistas")
}

enum PlanSuscripcion {
  BASICO
  PROFESIONAL
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
  EXPIRADA
  PRUEBA
}

model Suscripcion {
  id              String             @id @default(cuid())
  dietistaId      String             @unique
  dietista        Dietista           @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  plan            PlanSuscripcion    @default(BASICO)
  estado          EstadoSuscripcion  @default(PRUEBA)
  fechaInicio     DateTime           @default(now())
  fechaFin        DateTime?
  stripeCustomerId    String?
  stripeSubscriptionId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("suscripciones")
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
}

enum ObjetivoPaciente {
  PERDER_PESO
  GANAR_MASA
  MANTENIMIENTO
  PATOLOGIA
  DEPORTIVO
  OTRO
}

enum CategoriaAlimento {
  FRUTAS
  VERDURAS
  CEREALES
  LEGUMBRES
  CARNES
  PESCADOS
  LACTEOS
  HUEVOS
  FRUTOS_SECOS
  ACEITES
  BEBIDAS
  CONDIMENTOS
  DULCES
  OTROS
}

enum UnidadMedida {
  GRAMOS
  MILILITROS
  UNIDAD
  CUCHARADA
  CUCHARADITA
  TAZA
  REBANADA
  PIEZA
}

enum OrigenAlimento {
  API
  PERSONALIZADO
}

enum TipoComida {
  DESAYUNO
  MEDIA_MANANA
  ALMUERZO
  MERIENDA
  CENA
  RECENA
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model Paciente {
  id                  String            @id @default(cuid())
  dietistaId          String
  dietista            Dietista          @relation(fields: [dietistaId], references: [id], onDelete: Cascade)

  nombre              String
  apellidos           String
  email               String?
  telefono            String?
  fotoUrl             String?
  fechaNacimiento     DateTime?
  sexo                Sexo?

  peso                Float?
  altura              Float?

  alergias            String[]
  intolerancias       String[]
  patologias          String[]
  medicamentos        String[]
  suplementos         String[]

  objetivo            ObjetivoPaciente  @default(MANTENIMIENTO)
  objetivoDetalle     String?

  nivelActividad      String?
  frecuenciaEjercicio String?
  tipoEjercicio       String?
  horarioTrabajo      String?
  horarioEjercicio    String?
  horasDescanso       String?
  ocupacion           String?

  preferencias        String[]
  notas               String?

  /// Formulario extendido tipo ficha clínica (pestaña Información)
  fichaInformacion    Json?

  /// Horario de paciente (guardado como JSONB)
  horario             Json?
  /// Recomendaciones clínicas (guardadas como texto)
  recomendaciones     String?

  activo              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  planes              PlanAlimenticio[]
  medidas             MedidaAntropometrica[]
  consultas           Consulta[]
  citas               Cita[]
  acceso              AccesoPaciente?
  entradasDiario      EntradaDiario[]
  generacionesIA      GeneracionIA[]
  seguimiento         SeguimientoDiario[]
  notificaciones      Notificacion[]
  conversaciones      Conversacion[]
  mensajes            Mensaje[]
  googleIntegracion   GoogleIntegracionPaciente?

  @@map("pacientes")
}

model Alimento {
  id              String            @id @default(cuid())
  nombre          String
  categoria       CategoriaAlimento
  calorias        Float
  proteinas       Float
  carbohidratos   Float
  grasas          Float
  fibra           Float             @default(0)
  // Micronutrientes (por 100g)
  vitaminaA       Float?            // ug
  vitaminaB6      Float?            // mg
  vitaminaB12     Float?            // ug
  vitaminaC       Float?            // mg
  vitaminaD       Float?            // ug
  vitaminaE       Float?            // mg
  vitaminaK       Float?            // ug
  tiamina         Float?            // mg (B1)
  riboflavina     Float?            // mg (B2)
  niacina         Float?            // mg (B3)
  folato          Float?            // ug (B9)
  acidoPantotenico Float?           // mg (B5)
  colina          Float?            // mg
  calcio          Float?            // mg
  hierro          Float?            // mg
  magnesio        Float?            // mg
  fosforo         Float?            // mg
  potasio         Float?            // mg
  sodio           Float?            // mg
  cinc            Float?            // mg
  cobre           Float?            // mg
  manganeso       Float?            // mg
  selenio         Float?            // ug
  fluor           Float?            // ug
  porcion         Float             @default(100)
  unidad          UnidadMedida      @default(GRAMOS)
  origen          OrigenAlimento    @default(PERSONALIZADO)
  codigoBarras    String?
  dietistaId      String?
  dietista        Dietista?         @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  recetaIngredientes  RecetaIngrediente[]
  alimentosEnComida   AlimentoEnComida[]
  entradasDiario      EntradaDiario[]

  @@map("alimentos")
}

model Receta {
  id              String    @id @default(cuid())
  nombre          String
  descripcion     String?
  instrucciones   String?
  porciones       Int       @default(1)
  tiempoPreparacion Int?
  calorias        Float     @default(0)
  proteinas       Float     @default(0)
  carbohidratos   Float     @default(0)
  grasas          Float     @default(0)
  fibra           Float     @default(0)
  vitaminaA       Float?
  vitaminaB6      Float?
  vitaminaB12     Float?
  vitaminaC       Float?
  vitaminaD       Float?
  vitaminaE       Float?
  vitaminaK       Float?
  tiamina         Float?
  riboflavina     Float?
  niacina         Float?
  folato          Float?
  acidoPantotenico Float?
  colina          Float?
  calcio          Float?
  hierro          Float?
  magnesio        Float?
  fosforo         Float?
  potasio         Float?
  sodio           Float?
  cinc            Float?
  cobre           Float?
  manganeso       Float?
  selenio         Float?
  fluor           Float?
  dietistaId      String?
  dietista        Dietista? @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ingredientes    RecetaIngrediente[]
  alimentosEnComida AlimentoEnComida[]
  entradasDiario    EntradaDiario[]
  favoritos         RecetaFavorito[]

  @@map("recetas")
}

model RecetaFavorito {
  id          String    @id @default(cuid())
  dietistaId  String
  dietista    Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  recetaId    String
  receta      Receta    @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([dietistaId, recetaId])
  @@map("receta_favoritos")
}

model RecetaIngrediente {
  id          String       @id @default(cuid())
  recetaId    String
  receta      Receta       @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  alimentoId  String
  alimento    Alimento     @relation(fields: [alimentoId], references: [id], onDelete: Cascade)
  cantidad    Float
  unidad      UnidadMedida @default(GRAMOS)

  @@map("receta_ingredientes")
}

model PlanAlimenticio {
  id              String    @id @default(cuid())
  pacienteId      String
  paciente        Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  dietistaId      String
  dietista        Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  nombre          String
  caloriasObjetivo  Float?
  proteinasObjetivo Float?
  carbohidratosObjetivo Float?
  grasasObjetivo    Float?
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dias            DiaDelPlan[]
  enlaces         EnlaceCompartido[]

  @@map("planes_alimenticios")
}

model DiaDelPlan {
  id      String      @id @default(cuid())
  planId  String
  plan    PlanAlimenticio @relation(fields: [planId], references: [id], onDelete: Cascade)
  dia     DiaSemana

  comidas ComidaDelDia[]

  @@unique([planId, dia])
  @@map("dias_del_plan")
}

model ComidaDelDia {
  id          String      @id @default(cuid())
  diaId       String
  diaDelPlan  DiaDelPlan @relation(fields: [diaId], references: [id], onDelete: Cascade)
  tipo        TipoComida
  orden       Int         @default(0)
  descripcion String?

  alimentos AlimentoEnComida[]

  @@map("comidas_del_dia")
}

model AlimentoEnComida {
  id          String       @id @default(cuid())
  comidaId    String
  comida      ComidaDelDia @relation(fields: [comidaId], references: [id], onDelete: Cascade)
  alimentoId  String?
  alimento    Alimento?    @relation(fields: [alimentoId], references: [id], onDelete: SetNull)
  recetaId    String?
  receta      Receta?      @relation(fields: [recetaId], references: [id], onDelete: SetNull)
  cantidad    Float
  unidad      UnidadMedida @default(GRAMOS)
  orden       Int          @default(0)

  @@map("alimentos_en_comida")
}

model Plantilla {
  id          String    @id @default(cuid())
  dietistaId  String
  dietista    Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  nombre      String
  datos       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("plantillas")
}

model MedidaAntropometrica {
  id                  String    @id @default(cuid())
  pacienteId          String
  paciente            Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  fecha               DateTime  @default(now())
  peso                Float?
  altura              Float?
  imc                 Float?
  grasaCorporal       Float?
  masaMuscular        Float?
  perimetroCintura    Float?
  perimetroCadera     Float?
  perimetroBrazo      Float?
  notas               String?
  createdAt           DateTime  @default(now())

  consulta            Consulta?

  @@map("medidas_antropometricas")
}

model Consulta {
  id              String    @id @default(cuid())
  pacienteId      String
  paciente        Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  dietistaId      String
  dietista        Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  fecha           DateTime  @default(now())
  motivo          String?
  notas           String?
  medidaId        String?   @unique
  medida          MedidaAntropometrica? @relation(fields: [medidaId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("consultas")
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  CONTRAPROPUESTA
}

enum OrigenCita {
  DIETISTA
  PACIENTE
}

model Cita {
  id              String      @id @default(cuid())
  pacienteId      String
  paciente        Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  dietistaId      String
  dietista        Dietista    @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  fechaHora       DateTime
  duracion        Int         @default(30)
  motivo          String?
  estado          EstadoCita  @default(PENDIENTE)
  notas           String?
  origen          OrigenCita  @default(DIETISTA)
  propuestoPor    OrigenCita  @default(DIETISTA)
  citaOriginalId  String?
  isOnline                Boolean     @default(false)
  googleEventId           String?
  googleEventIdPaciente   String?
  googleMeetLink          String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  notificaciones  Notificacion[]

  @@map("citas")
}

model GoogleIntegracion {
  id           String   @id @default(cuid())
  dietistaId   String   @unique
  dietista     Dietista @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  calendarId   String   @default("primary")
  sincronizar  Boolean  @default(true)
  crearMeet    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("google_integraciones")
}

model GoogleIntegracionPaciente {
  id           String   @id @default(cuid())
  pacienteId   String   @unique
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  calendarId   String   @default("primary")
  sincronizar  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("google_integraciones_paciente")
}

model EnlaceCompartido {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  planId      String
  plan        PlanAlimenticio @relation(fields: [planId], references: [id], onDelete: Cascade)
  dietistaId  String
  dietista    Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  activo      Boolean   @default(true)
  expiraEn    DateTime?
  createdAt   DateTime  @default(now())

  @@map("enlaces_compartidos")
}

model AccesoPaciente {
  id              String    @id @default(cuid())
  pacienteId      String    @unique
  paciente        Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  email           String    @unique
  pinHash         String
  passwordHash    String?
  perfilCompleto  Boolean   @default(false)
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("accesos_paciente")
}

model EntradaDiario {
  id          String       @id @default(cuid())
  pacienteId  String
  paciente    Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  fecha       DateTime     @default(now())
  tipoComida  TipoComida
  descripcion String?
  alimentoId  String?
  alimento    Alimento?    @relation(fields: [alimentoId], references: [id], onDelete: SetNull)
  recetaId    String?
  receta      Receta?      @relation(fields: [recetaId], references: [id], onDelete: SetNull)
  cantidad    Float?
  unidad      UnidadMedida?
  notas       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("entradas_diario")
}

enum EstadoGeneracion {
  BORRADOR
  APLICADO
  DESCARTADO
}

model GeneracionIA {
  id              String           @id @default(cuid())
  dietistaId      String
  dietista        Dietista         @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  pacienteId      String
  paciente        Paciente         @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  prompt          String
  respuesta       Json
  estado          EstadoGeneracion @default(BORRADOR)
  createdAt       DateTime         @default(now())

  @@map("generaciones_ia")
}

enum TipoNotificacion {
  CITA_HOY
  PACIENTE_SIN_CONSULTA
  PACIENTE_SIN_MEDIDAS
  PLAN_ANTIGUO
  DIARIO_NUEVO
  CITA_SOLICITADA
  CITA_CONFIRMADA
  CITA_CONTRAPROPUESTA
  CITA_RECHAZADA
  CITA_CANCELADA_POR_PACIENTE
  PAGO_RECIBIDO
  PAGO_PENDIENTE
  PAGO_FALLIDO
}

model Notificacion {
  id          String            @id @default(cuid())
  dietistaId  String?
  dietista    Dietista?         @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  pacienteId  String?
  paciente    Paciente?         @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  citaId      String?
  cita        Cita?             @relation(fields: [citaId], references: [id], onDelete: SetNull)
  tipo        TipoNotificacion
  titulo      String
  mensaje     String
  leida       Boolean           @default(false)
  enlace      String?
  createdAt   DateTime          @default(now())

  @@index([dietistaId, leida])
  @@index([pacienteId, leida])
  @@index([citaId, leida])
  @@map("notificaciones")
}

model SeguimientoDiario {
  id                    String   @id @default(cuid())
  pacienteId            String
  paciente              Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  fecha                 DateTime @db.Date
  cumplido              Boolean  @default(false)
  aguaML                Int      @default(0)
  ejercicio             Boolean  @default(false)
  ejercicioMinutos      Int      @default(0)
  ejercicioKcal         Int      @default(0)
  ejercicioTipo         String?
  ejercicioDistanciaKm  Float    @default(0)
  notas                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([pacienteId, fecha])
  @@map("seguimiento_diario")
}


enum AutorMensaje {
  DIETISTA
  PACIENTE
}

model Conversacion {
  id              String    @id @default(cuid())
  dietistaId      String
  dietista        Dietista  @relation(fields: [dietistaId], references: [id], onDelete: Cascade)
  pacienteId      String
  paciente        Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  ultimoMensajeAt DateTime?
  archivadaDietista Boolean @default(false)

  noLeidosDietista Int @default(0)
  noLeidosPaciente Int @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mensajes        Mensaje[]

  @@unique([dietistaId, pacienteId])
  @@index([dietistaId, ultimoMensajeAt])
  @@index([pacienteId, ultimoMensajeAt])
  @@map("conversaciones")
}

model Mensaje {
  id             String       @id @default(cuid())
  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  autor          AutorMensaje
  dietistaId     String?
  dietista       Dietista?    @relation(fields: [dietistaId], references: [id], onDelete: SetNull)
  pacienteId     String?
  paciente       Paciente?    @relation(fields: [pacienteId], references: [id], onDelete: SetNull)

  texto          String
  adjuntoUrl     String?
  adjuntoNombre  String?
  adjuntoTipo    String?

  leidoEn        DateTime?

  createdAt      DateTime     @default(now())

  @@index([conversacionId, createdAt])
  @@map("mensajes")
}

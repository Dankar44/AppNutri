# Copia a .env.local y rellena

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Base de datos (Supabase PostgreSQL pooler)
DATABASE_URL="postgresql://postgres:PASSWORD@db.TU_REF.supabase.co:5432/postgres"

# Groq (opcional, para generación de dietas con IA - rotación automática)
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...

# JWT para portal del paciente (cambiar en producción)
PATIENT_JWT_SECRET=cambiar-esta-clave-en-produccion

# Email (Resend - https://resend.com)
RESEND_API_KEY=re_...
# RESEND_FROM_DOMAIN=noreply@tudominio.com  # (opcional, por defecto onboarding@resend.dev)

# Admin panel (emails separados por coma)
ADMIN_EMAILS=
ADMIN_PASSWORD=

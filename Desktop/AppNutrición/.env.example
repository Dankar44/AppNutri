# Copia a .env.local y rellena

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Base de datos (Supabase PostgreSQL pooler)
DATABASE_URL="postgresql://postgres:PASSWORD@db.TU_REF.supabase.co:5432/postgres"

# Groq (opcional, para generación de dietas con IA - rotación automática)
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...

# JWT para portal del paciente (cambiar en producción)
PATIENT_JWT_SECRET=cambiar-esta-clave-en-produccion

# Email (Resend - https://resend.com)
RESEND_API_KEY=re_...
# RESEND_FROM_DOMAIN=noreply@tudominio.com  # (opcional, por defecto onboarding@resend.dev)

# Admin panel (emails separados por coma)
ADMIN_EMAILS=
ADMIN_PASSWORD=

# Google OAuth (Calendar + Meet + Sign in with Google)
# 1. https://console.cloud.google.com → Crear proyecto
# 2. APIs & Services → Library → activar "Google Calendar API"
# 3. Credentials → "OAuth client ID" → Web application
#    - Authorized redirect URIs:
#      http://localhost:3000/api/google/callback-nutri
#      http://localhost:3000/api/google/callback-paciente
#      https://TU_DOMINIO/api/google/callback-nutri
#      https://TU_DOMINIO/api/google/callback-paciente
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_NUTRI=http://localhost:3000/api/google/callback-nutri
GOOGLE_REDIRECT_URI_PACIENTE=http://localhost:3000/api/google/callback-paciente

# Cifrado de tokens OAuth en BD (AES-256-GCM)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin esta clave los tokens se guardan en texto plano (aceptable solo en desarrollo)
ENCRYPTION_KEY=
